+  // 修法：查表前把分隔符（撇号和空格）从 code 里删掉。对普通拼音表
+  //   （如 rime_ice 的 melt_eng / table_translator@custom_phrase）没有副作用，
+  //   因为它们的码本来就不含分隔符，删了等于没删。
+  //   注意 preedit 仍用原始 input，所以候选上方显示的还是用户打的原样。
+  {
+    const string kSep = delimiters_ + " ";
+    string cleaned;
+    cleaned.reserve(code.size());
+    for (char ch : code) {
+      if (kSep.find(ch) == string::npos)
+        cleaned.push_back(ch);
+    }
+    if (cleaned != code) {
+      DLOG(INFO) << "table lookup: stripping delimiters '" << code << "' -> '"
+                 << cleaned << "'";
+      code.swap(cleaned);
+    }
+  }
